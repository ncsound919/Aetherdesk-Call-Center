# Aetherdesk — SaaS production environment template
# Copy to .env and fill for a NEW customer deployment (this is a product, not a personal copy).
# Never commit real .env. Rotate every value per deployment.

# ── Deployment identity ──────────────────────────────────────────────────────
PUBLIC_DOMAIN=your-aetherdesk-instance.example.com
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong

# ── Database (Postgres, tenant-isolated per deployment) ─────────────────────
DB_USER=aetherdesk
DB_PASSWORD=change-me
DB_NAME=aetherdesk
REDIS_PASSWORD=change-me

# ── Speech ───────────────────────────────────────────────────────────────────
TTS_ENGINE=chatterbox          # self-hosted, free
STT_ENGINE=deepgram
DEEPGRAM_API_KEY=your-deepgram-key

# ── Call platform (Fonoster) ────────────────────────────────────────────────
FONOSTER_API_KEY=your-fonoster-key
FONOSTER_API_SECRET=your-fonoster-secret

# ── Billing (optional — SaaS monetization) ──────────────────────────────────
BILLING_PROVIDER=stripe         # none | stripe
STRIPE_SECRET_KEY=your-stripe-secret

# ── Observability / logging ─────────────────────────────────────────────────
LOG_LEVEL=info
AGENTOPS_API_KEY=
